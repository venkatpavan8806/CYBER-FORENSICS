<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>RansomTrace Report - {{ generated_at }}</title>
<style>
  :root {
    --bg: #0f1420; --panel: #161d2e; --border: #2a3348; --text: #e6e9f0;
    --muted: #94a1b8; --accent: #5b8cff; --high: #ef4a5f; --medium: #f2a93b;
    --low: #6fbf73; --confirmed: #2fbf71; --false-positive: #6b7280; --uncertain: #f2a93b;
  }
  body { background: var(--bg); color: var(--text); font-family: -apple-system, Segoe UI, Roboto, sans-serif;
         margin: 0; padding: 0 0 4rem 0; }
  header { background: var(--panel); border-bottom: 1px solid var(--border); padding: 2rem; }
  header h1 { margin: 0 0 0.25rem 0; font-size: 1.6rem; }
  header .subtitle { color: var(--muted); font-size: 0.95rem; }
  .container { max-width: 900px; margin: 0 auto; padding: 0 2rem; }
  .meta-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
               gap: 0.75rem; margin-top: 0.75rem; }
  .section-heading { font-size: 1rem; color: var(--muted); text-transform: uppercase;
                      letter-spacing: 0.05em; margin: 2rem 0 0 0; }
  .meta-item { background: var(--panel); border: 1px solid var(--border); border-radius: 8px;
               padding: 0.75rem 1rem; }
  .meta-item .label { color: var(--muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; }
  .meta-item .value { font-family: "SF Mono", Consolas, monospace; font-size: 0.85rem; word-break: break-all; margin-top: 0.25rem; }
  .limitations { background: #2a1f10; border: 1px solid #6b4a1a; border-radius: 8px; padding: 1rem 1.25rem;
                 margin: 1.5rem 0; font-size: 0.9rem; }
  .limitations strong { color: #f2a93b; }
  .finding { background: var(--panel); border: 1px solid var(--border); border-radius: 10px;
             padding: 1.25rem 1.5rem; margin: 1.25rem 0; }
  .finding-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap; }
  .finding-title { font-size: 1.1rem; font-weight: 600; margin: 0; }
  .badges { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .badge { font-size: 0.72rem; padding: 0.2rem 0.55rem; border-radius: 999px; font-weight: 600;
           text-transform: uppercase; letter-spacing: 0.03em; white-space: nowrap; }
  .badge-confidence-high { background: rgba(239,74,95,0.15); color: var(--high); border: 1px solid var(--high); }
  .badge-confidence-medium { background: rgba(242,169,59,0.15); color: var(--medium); border: 1px solid var(--medium); }
  .badge-confidence-low { background: rgba(111,191,115,0.15); color: var(--low); border: 1px solid var(--low); }
  .badge-status-confirmed { background: rgba(47,191,113,0.15); color: var(--confirmed); border: 1px solid var(--confirmed); }
  .badge-status-false-positive { background: rgba(107,114,128,0.15); color: var(--false-positive); border: 1px solid var(--false-positive); }
  .badge-status-uncertain { background: rgba(242,169,59,0.15); color: var(--uncertain); border: 1px solid var(--uncertain); }
  .badge-status-unreviewed { background: rgba(148,161,184,0.15); color: var(--muted); border: 1px solid var(--muted); }
  .badge-mitre { background: rgba(91,140,255,0.15); color: var(--accent); border: 1px solid var(--accent); }
  .finding-meta { color: var(--muted); font-size: 0.82rem; margin: 0.5rem 0 0.75rem 0; }
  .finding-description { margin: 0.5rem 0 1rem 0; line-height: 1.5; }
  .analyst-note { background: #10202a; border-left: 3px solid var(--accent); padding: 0.6rem 0.9rem;
                  margin: 0.75rem 0; font-size: 0.88rem; }
  details summary { cursor: pointer; color: var(--muted); font-size: 0.85rem; margin-top: 0.5rem; }
  .evidence-item { font-family: "SF Mono", Consolas, monospace; font-size: 0.78rem; background: #0d1220;
                    border: 1px solid var(--border); border-radius: 6px; padding: 0.6rem 0.8rem; margin: 0.4rem 0; }
  .evidence-item .ev-desc { color: var(--text); margin-bottom: 0.3rem; }
  .evidence-item .ev-raw { color: var(--muted); white-space: pre-wrap; word-break: break-all; }
  footer { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--border); color: var(--muted);
           font-size: 0.8rem; line-height: 1.6; }
  .empty-state { color: var(--muted); text-align: center; padding: 3rem 0; }
</style>
</head>
<body>
<header>
  <div class="container">
    <h1>RansomTrace &mdash; Ransomware Artifact Analysis Report</h1>
    <div class="subtitle">Cyber Forensics Capstone &mdash; Disk Forensics</div>
  </div>
</header>

<div class="container">
  <div class="meta-grid">
    <div class="meta-item"><div class="label">Analyzed input</div><div class="value">{{ input_path }}</div></div>
    <div class="meta-item"><div class="label">Ingestion mode</div><div class="value">{{ mode }}</div></div>
    <div class="meta-item"><div class="label">Findings</div><div class="value">{{ findings|length }} total</div></div>
  </div>

  <h2 class="section-heading">Chain of custody</h2>
  <div class="meta-grid">
    <div class="meta-item"><div class="label">{{ hash_algorithm }} (chain of custody)</div><div class="value">{{ input_hash }}</div></div>
    <div class="meta-item"><div class="label">Tool version</div><div class="value">RansomTrace {{ tool_version }}</div></div>
    {% if processing_started_at %}
    <div class="meta-item"><div class="label">Processing started</div><div class="value">{{ processing_started_at }}</div></div>
    <div class="meta-item"><div class="label">Processing completed</div><div class="value">{{ generated_at }}</div></div>
    <div class="meta-item"><div class="label">Processing elapsed</div><div class="value">{{ "%.2f"|format(processing_elapsed_seconds) }} seconds</div></div>
    {% else %}
    <div class="meta-item"><div class="label">Report generated</div><div class="value">{{ generated_at }}</div></div>
    {% endif %}
  </div>

  <div class="limitations">
    <strong>Scope &amp; limitations:</strong> single-host, single-image, NTFS/Windows-only analysis.
    Findings are produced by a documented, rule-based engine (not machine learning) and are not
    exhaustive - absence of a finding is not proof of absence of an incident. If a "Clear Windows
    Event Logs" finding (T1070.001) appears below, evidence may be incomplete due to log clearing.
    Every finding requires human analyst review before being treated as confirmed.
  </div>

  {% if not findings %}
  <div class="empty-state">No findings were produced from this input.</div>
  {% endif %}

  {% for f in findings %}
  <div class="finding">
    <div class="finding-header">
      <h2 class="finding-title">{{ f.title }}</h2>
      <div class="badges">
        <span class="badge badge-confidence-{{ f.confidence|lower }}">{{ f.confidence }} confidence</span>
        <span class="badge badge-status-{{ f.validation_status.value|lower|replace(' ', '-') }}">{{ f.validation_status.value }}</span>
        {% for t in f.mitre_techniques %}
        <span class="badge badge-mitre" title="{{ t|technique_name }}">{{ t }}</span>
        {% endfor %}
      </div>
    </div>
    <div class="finding-meta">
      Rule {{ f.rule_id }} &middot; Finding ID {{ f.finding_id }} &middot;
      Window: {{ f.window_start.isoformat() }} &ndash; {{ f.window_end.isoformat() }}
    </div>
    <p class="finding-description">{{ f.description }}</p>

    {% if f.analyst_note %}
    <div class="analyst-note"><strong>Analyst note:</strong> {{ f.analyst_note }}</div>
    {% endif %}

    <details>
      <summary>{{ f.evidence|length }} supporting event(s) &mdash; click to expand raw evidence</summary>
      {% for e in f.evidence %}
      <div class="evidence-item">
        <div class="ev-desc">[{{ e.source_extractor.value }} / {{ e.event_type }}] {{ e.timestamp.isoformat() }}</div>
        <div class="ev-desc">{{ e.description }}</div>
        <div class="ev-raw">{{ e.raw_evidence }}</div>
      </div>
      {% endfor %}
    </details>
  </div>
  {% endfor %}

  <footer>
    RansomTrace is a rule-based, single-host, offline forensic analysis tool built for a BTech
    Cyber Forensics capstone project. It performs no machine learning, no network access, and no
    live/real-time monitoring. All findings are traceable to specific raw evidence extracted from
    the input above; none are inferred without a documented rule. This report reflects only what
    the ruleset in correlation/rules.py detected at generation time and the validation status an
    analyst assigned via the CLI or Streamlit review step.
  </footer>
</div>
</body>
</html>
